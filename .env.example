# Copy to .env. Secrets are read at runtime; never commit .env.
DOCS_BIND=127.0.0.1
DOCS_PORT=8088
# Server build output (not static-dist). Must exist before starting Compose.
DOCS_CONTENT_DIR=./modern-docs/dist
# Build-time setting; export this before building (or set site.config.json siteUrl).
DOCS_SITE_URL=
# Exact proxy peer IPs, comma separated. Proxy must overwrite X-Real-IP.
DOCS_TRUSTED_PROXIES=
# OpenAI-compatible API, including /v1; Ollama example below.
AI_BASE_URL=http://host.docker.internal:11434/v1
AI_MODEL=qwen3:8b
AI_API_KEY=
# Set both to protect all pages, search index, images and API.
DOCS_AUTH_USER=
DOCS_AUTH_PASSWORD=
